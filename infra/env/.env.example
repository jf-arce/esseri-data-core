# Para Railway, configurar variables por servicio según infra/railway.md.
# No importar este archivo completo en n8n: N8N_WEBHOOK_URL tiene otro uso allí.
# Variables para levantar el stack completo con infra/docker-compose.prod.yml
# Copiar a infra/env/.env (nunca commitear ese archivo con valores reales).
#
# Postgres, backend y n8n leen infra/env/.env vía `env_file` en docker-compose.prod.yml.
# VITE_API_URL es distinta: Vite la incrusta en el build en tiempo de compilación,
# así que docker-compose la necesita como variable de shell (o en infra/.env, que
# Docker Compose carga automáticamente) para pasarla como build arg al frontend.

# --- Postgres ---
POSTGRES_USER=esseri
POSTGRES_PASSWORD=
POSTGRES_DB=esseri_data_core

# --- Backend (ver backend/.env.example para el detalle de cada variable) ---
ENVIRONMENT=production
# Completar con la misma clave que POSTGRES_PASSWORD (codificada para una URL).
DATABASE_URL=postgresql://esseri:<clave-postgres>@postgres:5432/esseri_data_core
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.esseri.example/auth/google/callback
OPENAI_API_KEY=
FACTURACION_AUTOMATICA_HABILITADA=true
FACTURACION_HORA_EJECUCION=00:05
WORKFLOWS_DESPACHO_HABILITADO=true
WORKFLOWS_DESPACHO_INTERVALO_SEGUNDOS=30
N8N_WEBHOOK_URL=http://n8n:5678/webhook/enviar-email
N8N_WEBHOOK_TOKEN=
CORS_ORIGINS=["https://app.esseri.example"]

# Opciones del backend: ver backend/.env.example y el manual para su finalidad.
FRONTEND_URL=https://app.esseri.example
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
LOGIN_MAX_INTENTOS=10
LOGIN_VENTANA_MINUTOS=15
LOGIN_BLOQUEO_MINUTOS=15
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEGUNDOS=30
IA_MOROSIDAD_DIAS_VENCIDO=30
IA_INASISTENCIAS_CANTIDAD=3
IA_INASISTENCIAS_VENTANA_DIAS=30

# Asistente de IA: detalle en backend/README.md, sección "Asistente de IA".
ASISTENTE_HABILITADO=true
ASISTENTE_MAX_PASOS=6
ASISTENTE_MAX_HERRAMIENTAS_POR_PASO=4
ASISTENTE_MENSAJES_POR_DIA=100
ASISTENTE_MAX_CARACTERES_ENTRADA=2000
ASISTENTE_VENTANA_HISTORIAL=12
ASISTENTE_MAX_FILAS_RESULTADO=20
ASISTENTE_RETENCION_DIAS=90
ASISTENTE_RETENCION_INTERVALO_HORAS=24
ASISTENTE_GENERACION_TIMEOUT_SEGUNDOS=180
N8N_MANUAL_HABILITADO=false
N8N_CALLBACK_BASE_URL=http://backend:8000
COMUNICACIONES_ADJUNTOS_HABILITADOS=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SEGUNDOS=10
EMAIL_INSTITUCION_NOMBRE=ESSERI
EMAIL_INSTITUCION_PIE=
EMAIL_LOGO_URL=

# --- Frontend (build arg, no runtime — ver nota arriba) ---
VITE_API_URL=https://api.esseri.example

# n8n: crear la cuenta propietaria desde su interfaz en el primer acceso.
# N8N_BASIC_AUTH_* no configura la autenticación de las versiones actuales.
