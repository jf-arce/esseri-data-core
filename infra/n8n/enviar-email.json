      "credentials": {
        "gmailOAuth2": {
          "id": "COMPLETAR",
          "name": "Gmail ESSERI"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"enviado\": true } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "3d8b8b9e-2e3f-4b77-9c75-2c5b8c2a3004",
      "name": "Responder OK",
