# Variables EXCLUSIVAS del servicio n8n en Railway (n8n 2.46.6).
# Reemplazar el dominio y completar el secreto antes de desplegar.
N8N_HOST=<dominio-generado-de-n8n>
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://<dominio-generado-de-n8n>
N8N_PROXY_HOPS=1
N8N_ENCRYPTION_KEY=
# Base pública de n8n; NO es la URL privada del webhook configurada en el backend.
N8N_WEBHOOK_URL=https://<dominio-generado-de-n8n>/
# Railway monta los volúmenes como root. Mantener los datos bajo el volumen persistente.
RAILWAY_RUN_UID=0
N8N_USER_FOLDER=/home/node
