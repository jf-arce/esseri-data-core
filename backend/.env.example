ENVIRONMENT=development

# Postgres local (ver infra/docker-compose.yml para levantarlo con Docker)
# La app fuerza la zona de la sesión en UTC; no hace falta configurarlo en Postgres.
DATABASE_URL=postgresql://esseri:esseri@localhost:5432/esseri_data_core

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google Identity/OAuth (RF-27, cambio 2 de la Revisión Maestra): Google autentica, el backend
# valida el token y emite el JWT interno de arriba. Se sacan de la consola de Google Cloud
# (credencial tipo "Web application"); el redirect URI de abajo tiene que estar registrado ahí tal
# cual. El secret solo vive acá, nunca en el frontend — ver backend/README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# A dónde vuelve el navegador después del callback de Google, ya con la cookie de sesión puesta.
FRONTEND_URL=http://localhost:5173

# Primer superadmin del sistema. Como el login rechaza usuarios que no estén cargados, alguien
# tiene que crear la primera fila desde afuera: database/seeds/00_bootstrap_admin.py.
# Si BOOTSTRAP_ADMIN_PASSWORD queda vacía, el script la pide por consola.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Bloqueo de POST /auth/login por IP: tras LOGIN_MAX_INTENTOS fallidos dentro de
# LOGIN_VENTANA_MINUTOS, la IP queda bloqueada LOGIN_BLOQUEO_MINUTOS (no puede ser menor que la ventana).
LOGIN_MAX_INTENTOS=10
LOGIN_VENTANA_MINUTOS=15
LOGIN_BLOQUEO_MINUTOS=15

# IA/Sugerencias: proveedor que redacta los borradores de comunicación. Sin clave, generar un
# borrador responde 503 y el resto del módulo (detección de patrones, revisión) sigue andando.
# La URL y el modelo se pueden apuntar a cualquier proveedor compatible con el protocolo de
# Chat Completions de OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEGUNDOS=30

# IA/Sugerencias: umbrales de la detección de patrones por reglas (no usa OpenAI).
# Morosidad: familias con deuda vencida hace más de N días.
# Inasistencias: alumnos con al menos N ausencias sin justificar en los últimos M días.
IA_MOROSIDAD_DIAS_VENCIDO=30
IA_INASISTENCIAS_CANTIDAD=3
IA_INASISTENCIAS_VENTANA_DIAS=30

# Job recuperable de facturación recurrente. Recupera pendientes al iniciar y luego corre todos
# los días a la hora de Argentina indicada; el día concreto de emisión se configura en cada regla.
FACTURACION_AUTOMATICA_HABILITADA=true
FACTURACION_HORA_EJECUCION=00:05

# Despachador de Workflows: cada N segundos procesa los eventos de negocio pendientes (EVENT_LOG)
# y ejecuta las reglas activas que les corresponden.
WORKFLOWS_DESPACHO_HABILITADO=true
WORKFLOWS_DESPACHO_INTERVALO_SEGUNDOS=30

# Webhook de n8n que envía los emails de Workflows (vacío = integración sin configurar).
# Con el backend fuera de Docker: http://localhost:5678/webhook/<ruta>. Con docker-compose,
# el backend llega a n8n por su nombre de servicio: http://n8n:5678/webhook/<ruta>.
# Usar la URL de producción (`/webhook/...`), no la de prueba (`/webhook-test/...`).
# Si el webhook usa Header Auth, poné acá el mismo token (se manda como `Authorization: Bearer`).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Identidad del mail institucional de Workflows.
# EMAIL_LOGO_URL tiene que ser pública (Gmail no muestra `data:` ni `localhost`); vacío = sin logo.
# EMAIL_INSTITUCION_PIE son los datos de contacto que van en el pie (opcional).
EMAIL_INSTITUCION_NOMBRE=ESSERI
EMAIL_INSTITUCION_PIE=
EMAIL_LOGO_URL=

# Lista JSON de orígenes permitidos para CORS
CORS_ORIGINS=["http://localhost:5173"]
