ENVIRONMENT=development

# Postgres local (ver infra/docker-compose.yml para levantarlo con Docker)
DATABASE_URL=postgresql://esseri:esseri@localhost:5432/esseri_data_core

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google Identity/OAuth (cambio 2 de docs/impacto-revision-maestra.md): Google autentica,
# el backend valida el token y emite el JWT interno de arriba. Ver GOOGLE_CLIENT_ID en
# frontend/.env.example — es el mismo client ID, el secret solo vive acá.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

OPENAI_API_KEY=

# Lista JSON de orígenes permitidos para CORS
CORS_ORIGINS=["http://localhost:5173"]
