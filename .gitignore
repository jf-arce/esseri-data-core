# Solo lo que aplica a todo el repo. Lo específico de cada capa
# (node_modules/, venv/, dist/, etc.) va en el .gitignore de esa capa.

.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# Backups locales de PostgreSQL; pueden contener datos personales y nunca se versionan.
backups/

# Configuración local de Claude Code
.claude/settings.local.json

# Cachés de Python
__pycache__/
*.pyc
