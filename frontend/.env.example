VITE_API_URL=http://localhost:8000

# Solo build Docker en Railway (no lo usa Vite en desarrollo):
# VITE_API_URL=/api
# NGINX_CONFIG=nginx-railway.conf
# Runtime del contenedor Nginx; en Railway usar la referencia privada del backend:
# BACKEND_UPSTREAM=backend.railway.internal:8000

# EvilCharts/Recharts en /panel no requiere variables de entorno adicionales.
