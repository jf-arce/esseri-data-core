VITE_API_URL=http://localhost:8000

# Google Identity/OAuth (RF-27, cambio 2 de la Revisión Maestra) — mismo client ID
# que GOOGLE_CLIENT_ID en backend/.env.example, expuesto acá porque lo usa el botón de
# login (Google Identity Services JS) en el navegador. El secret nunca vive en el frontend.
VITE_GOOGLE_CLIENT_ID=
